:{"id":"OJDijF-bpepB"}},{"cell_type":"code","source":["!pip install -q pdfplumber\n","import pdfplumber\n","from datetime import datetime\n","\n","def parsear_fecha_filename(nombre_archivo):\n","    partes = nombre_archivo.split('_')[0]  # \"31-08-23\"\n","    return datetime.strptime(partes, \"%d-%m-%y\").date()\n","\n","def limpiar_numero(valor):\n","    if valor is None:\n","        return None\n","    valor = valor.strip()\n","    if valor in (':', '', '-'):\n","        return None\n","    try:\n","        return float(valor.replace(',', '.'))\n","    except ValueError:\n","        return None\n","\n","def es_tabla_precios(tabla):\n","    if not tabla or len(tabla) < 4:\n","        return False\n","    header = tabla[0]\n","    if not header or not header[0]:\n","        return False\n","    return header[0].strip().upper() == \"PRODUCTOS\"\n","\n","def parsear_pdf(ruta_pdf):\n","    nombre = os.path.basename(ruta_pdf)\n","    fecha = parsear_fecha_filename(nombre)\n","    filas = []\n","    with pdfplumber.open(ruta_pdf) as pdf:\n","        for pagina in pdf.pages:\n","            for tabla in pagina.extract_tables():\n","                if not es_tabla_precios(tabla):\n","                    continue\n","                for fila in tabla:\n","                    if not fila or not fila[0]:\n","                        continue\n","                    producto = fila[0].strip()\n","                    if producto.upper() in ('', 'PRODUCTOS'):\n","                        continue\n","                    if len(fila) < 9:\n","                        continue\n","                    filas.append({\n","                        \"fecha\": fecha,\n","                        \"producto\": producto,\n","                        \"masa_hoy_t\": limpiar_numero(fila[2]),\n","                        \"unidad_medida\": fila[5].strip() if fila[5] else None,\n","                        \"equiv_kg\": limpiar_numero(fila[6]),\n","                        \"precio_ayer\": limpiar_nu